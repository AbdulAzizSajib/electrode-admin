# Origin of the Ecom API, including the /api/v1 path.
#
# Optional. Unset falls back to http://localhost:5000/api/v1, which is what you
# want for local development — copy this file to .env.local only when pointing
# the panel at a deployed API.
#
# Vite inlines this AT BUILD TIME. Changing it on a hosting platform does
# nothing until the panel is rebuilt and redeployed.
#
# Include /api/v1 — the bare origin will 404 every request.
VITE_API_BASE_URL=https://your-api-host.example.com/api/v1

# Origin of the customer storefront, with NO path.
#
# Optional. Unset falls back to http://localhost:4000, which is what you want
# for local development.
#
# The panel links OUT to the storefront — a landing page's "View page" and the
# active-campaign banner. The two are separate origins, so these links must be
# absolute: a bare /offer/<slug> resolves against the PANEL's origin and lands
# on the admin router, which renders its own "Page not found".
#
# Vite inlines this AT BUILD TIME, like VITE_API_BASE_URL above.
VITE_STOREFRONT_URL=https://your-shop-host.example.com
